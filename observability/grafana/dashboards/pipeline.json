    {
      "type": "stat",
      "title": "Contested, unadjudicated",
      "description": "Books whose sources disagree and that the tie-breaker has never seen.",
      "id": 219,
      "gridPos": {
        "h": 6,
        "w": 5,
        "x": 14,
        "y": 27
      },
      "datasource": {
        "type": "postgres",
        "uid": "catalogue"
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT count(*) AS value FROM (SELECT b.id FROM books b JOIN book_sources bs ON bs.book_id=b.id WHERE NOT EXISTS (SELECT 1 FROM book_sources g WHERE g.book_id=b.id AND g.source='goodreads') GROUP BY b.id HAVING count(DISTINCT bs.source) > 1) t",
          "datasource": {
            "type": "postgres",
            "uid": "catalogue"
          }
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "locale",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
