          "rawSql": "SELECT coalesce(fallback_reason, outcome) AS reason, count(*) AS n FROM resolution_attempts WHERE run_id = (SELECT run_id FROM resolution_attempts GROUP BY run_id ORDER BY max(observed_at) DESC LIMIT 1) AND outcome IN ('skipped','unavailable') GROUP BY 1 ORDER BY n DESC LIMIT 8",
          "datasource": {
            "type": "postgres",
