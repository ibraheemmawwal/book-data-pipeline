          "rawQuery": true,
          "rawSql": "SELECT left(b.title, 46) AS title, count(bs.source_id) AS sources, b.published_year AS year FROM books b LEFT JOIN book_sources bs ON bs.book_id = b.id GROUP BY b.id, b.title, b.published_year HAVING count(bs.source_id) <= 1 ORDER BY b.created_at DESC LIMIT 10",
