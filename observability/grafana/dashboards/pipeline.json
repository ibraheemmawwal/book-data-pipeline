          "refId": "A",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT date_trunc('hour', created_at) AS time, sum(count(*)) OVER (ORDER BY date_trunc('hour', created_at)) AS books FROM books WHERE $__timeFilter(created_at) GROUP BY 1 ORDER BY 1",
          "datasource": {
            "type": "postgres",
            "uid": "catalogue"
          }
