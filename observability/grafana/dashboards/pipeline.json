    {
      "type": "table",
      "title": "Latest run: what each source did",
      "description": "Where a run's wall clock actually goes. 'skipped' with a budget reason is the per-run cap working; 'unavailable' is the source refusing.",
      "id": 226,
      "gridPos": {
        "h": 8,
        "w": 13,
        "x": 0,
        "y": 41
      },
      "datasource": {
        "type": "postgres",
        "uid": "catalogue"
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT source, outcome, count(*) AS attempts, round(avg(duration_ms)) AS avg_ms, round(sum(duration_ms)/1000.0) AS total_s FROM resolution_attempts WHERE run_id = (SELECT run_id FROM resolution_attempts GROUP BY run_id ORDER BY max(observed_at) DESC LIMIT 1) GROUP BY source, outcome ORDER BY sum(duration_ms) DESC NULLS LAST",
          "datasource": {
            "type": "postgres",
            "uid": "catalogue"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "locale",
          "decimals": 0
