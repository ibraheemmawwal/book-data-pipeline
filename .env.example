# Copy to .env for local runs, then load it explicitly: uv run --env-file .env ...
# Settings never reads this file implicitly. Never commit .env.
# Every value below is a non-secret default except GOOGLE_BOOKS_API_KEY.
#
# Docker Compose is the exception: it reads .env from this directory on its own
# to substitute ${VAR} in compose.yml. Put the values the stack should run with
# in .env rather than exporting them in a shell, because compose.yml falls back
# to a *local* database and a Kafka-less graph when a variable is absent — so a
# rebuild launched from a different terminal silently retargets the pipeline
# from the source of truth to a throwaway container, and every task still
# succeeds.

# --- Catalogue database -----------------------------------------------------
# The pipeline is a long-running writer: the direct Neon endpoint, not the
# -pooler one the API uses.
PIPELINE_DATABASE_URL=postgresql+psycopg://pipeline:pipeline@localhost:5432/catalogue

# Whether the DAG resolves into Kafka (resolve_and_produce -> consumers) or
# loads directly (resolve_and_load). Read at parse time, so changing it changes
# the shape of the task graph, not just its behaviour.
PIPELINE_KAFKA_ENABLED=false

# --- Staging ----------------------------------------------------------------
PIPELINE_STAGING_DIR=./staging
PIPELINE_STAGING_RETENTION_DAYS=7

# --- Load -------------------------------------------------------------------
PIPELINE_LOAD_BATCH_SIZE=1000

# --- HTTP -------------------------------------------------------------------
PIPELINE_HTTP_CONNECT_TIMEOUT_SECONDS=5.0
PIPELINE_HTTP_READ_TIMEOUT_SECONDS=30.0
PIPELINE_HTTP_MAX_ATTEMPTS=5

# --- Gutendex (primary bulk source, no credentials) -------------------------
PIPELINE_GUTENDEX_ENABLED=true
PIPELINE_GUTENDEX_BASE_URL=https://gutendex.com
PIPELINE_GUTENDEX_MAX_RECORDS=6000

# --- Open Library (bounded enrichment; identified requests are required) ----
PIPELINE_OPENLIBRARY_ENABLED=true
PIPELINE_OPENLIBRARY_BASE_URL=https://openlibrary.org
PIPELINE_OPENLIBRARY_CONTACT_EMAIL=you@example.com
PIPELINE_OPENLIBRARY_REQUESTS_PER_SECOND=1.0
PIPELINE_OPENLIBRARY_MAX_RECORDS=500

# --- Google Books (skipped observably when the key is absent) ---------------
PIPELINE_GOOGLEBOOKS_ENABLED=true
PIPELINE_GOOGLEBOOKS_BASE_URL=https://www.googleapis.com
PIPELINE_GOOGLEBOOKS_API_KEY=
PIPELINE_GOOGLEBOOKS_MAX_RECORDS=500

# --- Kafka (phase 2 only) ---------------------------------------------------
PIPELINE_KAFKA_BOOTSTRAP_SERVERS=localhost:9092
PIPELINE_KAFKA_RAW_TOPIC=books.raw
PIPELINE_KAFKA_CLEAN_TOPIC=books.clean
PIPELINE_KAFKA_DLQ_TOPIC=books.dlq
PIPELINE_KAFKA_TOPIC_PARTITIONS=3
PIPELINE_KAFKA_MAX_PROCESSING_ATTEMPTS=3
